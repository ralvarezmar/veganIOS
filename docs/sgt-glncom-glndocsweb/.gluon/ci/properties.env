# Python parameters
PYTHON_BUILD_COMMAND="pip --version; rm -rf env-docs dist site; set -e; python -m venv ./env-docs; source env-docs/bin/activate; pip install setuptools; pip install -r requirements.txt --trusted-host nexus.alm.europe.cloudcenter.corp -i https://nexus.alm.europe.cloudcenter.corp/repository/pypi-public/simple; git config --global user.name 'mike'; git config --global user.email 'mike@ci.com'; git config --global core.symlinks true; temp_file=temp_file_docs; python setup.py --version > $temp_file; version=$(cat $temp_file); mike_version=$version; git_current_branch=${GITHUB_REF}; workflow_name=${GITHUB_WORKFLOW}; if [[ $workflow_name == 'Release TBD' ]]; then mike_branch=gh-pages-release; else mike_branch=gh-pages; fi; push_branch=false; mike_latest=' '; mike_update_aliases=' '; git fetch origin $mike_branch:$mike_branch --depth=1; current_time=$(date +%s); if [[ $git_current_branch == refs/pull/* ]]; then if [[ $workflow_name == 'Preview' ]]; then mike_version=PR-$(echo $git_current_branch | cut -d '/' -f 3); mike list --json --branch $mike_branch | jq length > $temp_file; num_versions=$(cat $temp_file); if [ $num_versions -gt 7 ]; then threshold=$((2 * 3600)); else threshold=$((4 * 3600)); fi; mike list --json --branch $mike_branch | jq -c '.[]' | while read -r version; do echo $version | jq -r '.version' > $temp_file; version_name=$(cat $temp_file); echo $version | jq -r '.properties.commitdate' > $temp_file; version_date=$(cat $temp_file); expr $current_time - $version_date > $temp_file; age=$(cat $temp_file); if [ $age -gt $threshold ] && [ $version_name != 'main' ]; then mike delete $version_name --branch $mike_branch; fi; done; push_branch=true; fi; if [[ $workflow_name == 'Security' ]]; then echo $git_current_branch | cut -d '/' -f 3 > $temp_file; mike_version=PR-$(cat $temp_file); push_branch=false; fi; elif [[ $git_current_branch == refs/heads/* ]]; then if [[ $workflow_name == 'Integration TBD' ]]; then mike_version=main; mike_latest=' latest '; push_branch=true; fi; elif [[ $git_current_branch == refs/tags/* ]]; then if [[ $workflow_name == 'Release TBD' ]]; then mike_version=$version; echo $mike_version | cut -d '.' -f 1,2 > $temp_file; mike_version=v$(cat $temp_file); mike_latest=' latest '; mike_update_aliases=' --update-aliases '; mike_branch=gh-pages-release; mike list --json --branch $mike_branch | jq length > $temp_file; if [ $(cat $temp_file) -gt 2 ]; then mike list --json --branch $mike_branch | jq -r 'sort_by(.version) | .[0].version' > $temp_file; oldest_version=$(cat $temp_file); mike list --json --branch $mike_branch | jq -r 'sort_by(.version) | .[-1].version' > $temp_file; newest_version=$(cat $temp_file); if [[ $newest_version == $mike_version ]]; then mike delete $newest_version --branch $mike_branch; else mike delete $oldest_version --branch $mike_branch; fi; fi; push_branch=true; fi; fi; mike deploy $mike_version $mike_latest $mike_update_aliases --branch $mike_branch; set +e; if [[ $mike_latest == ' latest ' ]]; then mike set-default latest --branch $mike_branch; fi; if [[ $push_branch == true ]]; then mike props $mike_version --set commitdate=$current_time --branch $mike_branch; git push origin $mike_branch --force; fi; git checkout $mike_branch -- html; mkdir -p dist; cp -r html dist/.; cp -r nginx/conf.d dist/conf.d; name=$(python setup.py --name); archive_name=$name-$version; cd dist; tar -czf $archive_name.tar.gz *; cd ..; deactivate"
CONTAINER_BUILD_ARGUMENTS="--build-arg ARTIFACT_PATH=${ARTIFACT_PATH} --build-arg CONFIG_PATH=${CONFIG_PATH}"

# Sonar parameters
SONAR_ID="SONAR_GLUON_COMMUNITY"
SONAR_PROJECT_KEY="sgt-glncom-glndocsweb"
PYTHON_SONAR_PROPERTIES="-Dsonar.sources=./docs/ -Dsonar.python.coverage.reportPaths=./coverage.xml"

# QG_ENABLED
QG_ENABLED="true"

# Fortify parameters
FORTIFY_PROJECT="sgt-glncom-glndocsweb"

# Title Validation (Preview)
CHK_PR_TITLE_ACTIVE="false"

# Description Validation (Preview)
CHK_PR_DESCRIPTION_ACTIVE="true"

# Markdown linter Validation (Preview)
CHK_PR_MARKDOWN_ACTIVE="true"

# Mkodcs build
PYTHON_VIRTUAL_ENVIRONMENT_DIRECTORY="env-docs"
PYTHON_REQUIREMENTS_PATH="requirements.txt"
PYTHON_SKIP_TEST="true"
