"app_name" = "VeganLens";
"portada_tagline" = "Vérifiez si c'est adapté aux véganes";
"portada_image_description" = "Illustration de fruits et légumes";
"portada_dismiss" = "Fermer l'écran de bienvenue";
"portada_tip_01" = "Pas d'œufs pour la pâtisserie ? Mélangez 1 c. à soupe de lin moulu avec 3 c. à soupe d'eau. Attendez 5 min. Le résultat est identique !";
"portada_tip_02" = "Le jus des boîtes de pois chiches (aquafaba) monte exactement comme des blancs d'œufs. Idéal pour les mousses ou meringues !";
"portada_tip_03" = "Le parmesan vous manque ? Mélangez de la levure diététique, des amandes en poudre, de l'ail en poudre et du sel. Identique et sain !";
"portada_tip_04" = "Pour un tofu croustillant qui absorbe les saveurs, pressez-le sous un poids avec un linge propre 15 minutes avant de le cuire.";
"portada_tip_05" = "Du tofu texture poulet ? Congelez-le dans son emballage, décongelez-le le lendemain et essorez-le. Sa texture va totalement changer.";
"portada_tip_06" = "Donnez un vrai goût d'œuf à vos tofus brouillés grâce au sel kala namak (sel noir). Le secret réside dans sa touche de soufre.";
"portada_tip_07" = "Saviez-vous que le café et le thé bloquent l'assimilation du fer ? Évitez d'en boire juste après vos repas principaux.";
"portada_tip_08" = "Doublez l'absorption du fer de vos légumineuses en ajoutant de la vitamine C (un filet de citron ou du poivron cru dans l'assiette).";
"portada_tip_09" = "Pas besoin d'associer riz et lentilles au même repas pour les protéines ; il suffit que les deux soient consommés dans la journée.";
"portada_tip_10" = "Préparez votre propre babeurre (buttermilk) vegan pour la pâtisserie : ajoutez une cuillère à café de vinaigre ou de jus de citron à votre lait végétal et laissez cailler 5 minutes.";
"portada_tip_11" = "La levure diététique ne donne pas juste un goût fromager, c'est aussi une mine de protéines et de vitamines B. Testez-la sur vos pâtes !";
"portada_tip_12" = "Activez les nutriments et digérez mieux les légumineuses et oléagineux en les laissant tremper dans l'eau tiède toute la nuit avant cuisson.";
"portada_tip_13" = "Faites votre propre crème vegan en mixant des noix de cajou crues (trempées au préalable) avec un peu d'eau. C'est ultra crémeux !";
"portada_tip_14" = "Épaissir vos sauces naturellement ? Ajoutez une cuillère à café de fécule de maïs ou de flocons de pomme de terre en fin de cuisson.";
"portada_tip_15" = "Le tofu soyeux (silken tofu) mixé avec du jus de citron et du sel remplace parfaitement la crème fraîche, le fromage frais ou le yaourt.";
"portada_tip_16" = "Un \"œuf\" brouillé express ? Émiettez du tofu ferme à la main directement dans la poêle. Sautez avec du curcuma pour la couleur jaune.";
"portada_tip_17" = "Envie d'une sauce crémeuse sans fromage ? Mixez de l'ail, des noix et un peu d'eau pour obtenir une base bien onctueuse.";
"portada_tip_18" = "Pour un burger moelleux, mélangez des légumineuses cuites avec des flocons d'avoine et des épices ; un peu de chapelure l'aide à tenir à la cuisson.";
"portada_tip_19" = "Faites un yaourt maison avec du lait végétal, un filet de citron et des graines de chia ; laissez reposer et la texture devient crémeuse.";
"portada_tip_20" = "Le curcuma, le cumin et le paprika donnent de la profondeur au tofu ou aux pois chiches, sans aucun ingrédient animal.";
"portada_tip_21" = "Pour un dessert sans lait, mixez une banane congelée avec du cacao et un filet de lait végétal jusqu'à obtenir une texture de glace.";
"portada_tip_22" = "Les légumineuses se digèrent mieux si vous les faites tremper la veille et les cuisez avec une feuille de laurier ou un peu de cumin.";
"portada_tip_23" = "Une béchamel vegan express ? Chauffez du lait végétal avec de la farine et une pincée de muscade pour une sauce bien crémeuse.";
"portada_tip_24" = "Le pesto se fait sans fromage : mixez basilic, pignons, ail, huile et un peu de levure diététique.";
"portada_tip_25" = "Pour une sauce à salade sans mayonnaise, mixez du tofu ferme avec moutarde, citron, huile et sel jusqu'à ce que ce soit crémeux.";
"portada_tip_26" = "Si votre lait végétal manque de goût, ajoutez une pincée de vanille ou de cannelle en le chauffant, pour vos desserts ou smoothies.";
"portada_tip_27" = "Un bon sofrito d'oignon, d'ail et de poivrons transforme des légumineuses sèches ou du tofu en un plat très savoureux avec peu d'ingrédients.";
"portada_tip_28" = "Pour une mayonnaise vegan maison, mixez de l'avocat ou du soja avec citron, moutarde et huile jusqu'à obtenir une texture lisse.";
"portada_tip_29" = "Les graines de lin et de chia épaississent parfaitement soupes, porridges et desserts, sans œuf ni produits laitiers.";
"portada_tip_30" = "Ajoutez un filet de sauce soja ou de tamari à vos légumes sautés pour un umami intense et savoureux.";
